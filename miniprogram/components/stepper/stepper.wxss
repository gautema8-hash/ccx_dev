.stepper {
  display: inline-flex;
  align-items: center;
  vertical-align: middle;
}

.stepper__btn {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  line-height: 1;
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.stepper__plus {
  background: linear-gradient(135deg, #d32f2f, #b71c1c);
  color: #fff;
  box-shadow: 0 4rpx 10rpx rgba(198, 40, 40, 0.3);
}

.stepper__minus {
  background: #fff;
  color: var(--c-primary, #c62828);
  border: 2rpx solid var(--c-primary, #c62828);
}

.stepper__minus.is-off {
  opacity: 0.3;
}

.stepper__num {
  min-width: 54rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  font-family: DIN, -apple-system, sans-serif;
  color: var(--c-text, #1f1f1f);
  transition: transform 0.15s ease;
}

.stepper__num.is-bounce {
  transform: scale(1.18);
}

.is-press {
  transform: scale(0.86);
  opacity: 0.85;
}

/* 大号：规格弹层内使用 */
.stepper.large .stepper__btn {
  width: 56rpx;
  height: 56rpx;
  font-size: 40rpx;
}
.stepper.large .stepper__num {
  min-width: 76rpx;
  font-size: 32rpx;
}

/* 小号：紧凑列表 */
.stepper.small .stepper__btn {
  width: 40rpx;
  height: 40rpx;
  font-size: 30rpx;
}
.stepper.small .stepper__num {
  min-width: 44rpx;
  font-size: 26rpx;
}
