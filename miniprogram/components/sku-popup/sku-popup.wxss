.sku-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.24s ease, visibility 0.24s;
  z-index: 200;
}
.sku-mask.is-show {
  opacity: 1;
  visibility: visible;
}

.sku-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 201;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  transform: translateY(102%);
  transition: transform 0.28s cubic-bezier(0.34, 1.2, 0.64, 1);
  max-height: 82vh;
  display: flex;
  flex-direction: column;
}
.sku-panel.is-show {
  transform: translateY(0);
}

/* ---------- 头部 ---------- */
.sku-head {
  position: relative;
  display: flex;
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid var(--c-line, #ededf0);
}
.sku-head__emoji {
  width: 140rpx;
  height: 140rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #fff4e5, #ffe8cc);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  margin-right: 24rpx;
  flex: none;
}
.sku-head__main {
  flex: 1;
  min-width: 0;
  padding-right: 40rpx;
}
.sku-head__name {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.sku-head__desc {
  font-size: 24rpx;
  color: var(--c-text-sub, #8a8a8e);
  margin-bottom: 12rpx;
}
.sku-head__price {
  color: var(--c-primary, #c62828);
  font-weight: 600;
  font-family: DIN, -apple-system, sans-serif;
}
.sku-head__num {
  font-size: 40rpx;
}
.sku-head__unit {
  font-size: 22rpx;
  color: var(--c-text-sub, #8a8a8e);
  font-weight: 400;
  margin-left: 4rpx;
}
.sku-head__close {
  position: absolute;
  right: 28rpx;
  top: 28rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f2f2f5;
  color: #9a9aa0;
  font-size: 26rpx;
}

/* ---------- 主体 ---------- */
.sku-body {
  flex: 1;
  max-height: 46vh;
  padding: 8rpx 32rpx 0;
}
.sku-group {
  padding: 24rpx 0 8rpx;
}
.sku-group__title {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.sku-group__req {
  margin-left: 12rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: var(--c-primary, #c62828);
  background: var(--c-primary-weak, #fdecec);
  border-radius: 6rpx;
  padding: 0 8rpx;
  line-height: 30rpx;
}
.sku-group__picked {
  margin-left: auto;
  font-size: 24rpx;
  font-weight: 400;
  color: var(--c-text-sub, #8a8a8e);
}
.sku-opts {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.sku-opt {
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 0 26rpx;
  border-radius: 32rpx;
  border: 2rpx solid var(--c-line, #ededf0);
  color: var(--c-text, #1f1f1f);
  font-size: 26rpx;
  background: #fafafc;
  transition: all 0.15s ease;
}
.sku-opt.is-on {
  font-weight: 600;
  background: #fff;
}
.sku-opt__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}
.sku-qty {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 12rpx;
}
.sku-qty__unit {
  font-size: 24rpx;
  color: var(--c-text-sub, #8a8a8e);
}
.sku-tip {
  margin: 16rpx 0 8rpx;
  padding: 16rpx 20rpx;
  background: #fafafc;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: var(--c-text-sub, #8a8a8e);
  line-height: 1.6;
}
.sku-holder {
  height: 200rpx;
}

/* ---------- 底部 ---------- */
.sku-foot {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  background: #fff;
  border-top: 1rpx solid var(--c-line, #ededf0);
  border-radius: 0 0 32rpx 32rpx;
}
.sku-foot__label {
  font-size: 22rpx;
  color: var(--c-text-sub, #8a8a8e);
}
.sku-foot__num {
  font-size: 40rpx;
}
.sku-foot__btn {
  height: 84rpx;
  padding: 0 64rpx;
  border-radius: 42rpx;
  background: linear-gradient(135deg, #d32f2f, #b71c1c);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(198, 40, 40, 0.28);
  transition: transform 0.12s ease;
}
.is-press {
  transform: scale(0.95);
  opacity: 0.9;
}
