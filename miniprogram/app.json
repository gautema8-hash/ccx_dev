{
  "pages": [
    "pages/menu/menu",
    "pages/cart/cart",
    "pages/orders/orders",
    "pages/mine/mine",
    "pages/confirm/confirm",
    "pages/order-detail/order-detail",
    "pages/store-list/store-list",
    "pages/voucher/voucher"
  ],
  "subPackages": [
    {
      "root": "packageUser",
      "name": "user",
      "pages": [
        "pages/coupon/coupon"
      ]
    }
  ],
  "preloadRule": {
    "pages/mine/mine": {
      "network": "all",
      "packages": ["user"]
    },
    "pages/confirm/confirm": {
      "network": "all",
      "packages": ["user"]
    }
  },
  "window": {
    "backgroundTextStyle": "dark",
    "navigationBarBackgroundColor": "#C62828",
    "navigationBarTitleText": "老北京麻辣串串香",
    "navigationBarTextStyle": "white",
    "backgroundColor": "#F5F5F7",
    "enablePullDownRefresh": false
  },
  "permission": {
    "scope.userLocation": {
      "desc": "用于为你推荐最近的门店并计算距离，方便就近点单与到店核销"
    }
  },
  "requiredPrivateInfos": ["getLocation"],
  "lazyCodeLoading": "requiredComponents",
  "style": "v2",
  "sitemapLocation": "sitemap.json",
  "debug": false
}
