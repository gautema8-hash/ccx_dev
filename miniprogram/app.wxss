/**
 * 老北京麻辣串串香 · 全局样式
 * 配色只有两个主色：麻辣红 #C62828 + 油泼金 #FF8F1F，其余为中性灰阶
 */
page {
  --c-primary: #c62828;
  --c-primary-weak: #fdecec;
  --c-primary-dark: #9e1b1b;
  --c-accent: #ff8f1f;
  --c-text: #1f1f1f;
  --c-text-sub: #8a8a8e;
  --c-text-weak: #b8b8bd;
  --c-line: #ededf0;
  --c-bg: #f5f5f7;
  --c-card: #ffffff;
  --radius-s: 8rpx;
  --radius: 16rpx;
  --radius-l: 24rpx;
  --shadow: 0 8rpx 24rpx rgba(31, 31, 31, 0.06);

  background: var(--c-bg);
  color: var(--c-text);
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue',
    Helvetica, Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
scroll-view,
image,
input,
textarea,
button,
label,
picker,
navigator {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: inherit;
  font-size: inherit;
  color: inherit;
}
button::after {
  border: none;
}

/* ---------- 通用原子类 ---------- */
.card {
  background: var(--c-card);
  border-radius: var(--radius);
  margin: 20rpx 24rpx;
  padding: 24rpx;
}

.row {
  display: flex;
  align-items: center;
}
.row--between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.grow {
  flex: 1;
  min-width: 0;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.price {
  color: var(--c-primary);
  font-weight: 600;
  font-family: DIN, -apple-system, sans-serif;
}
.price__unit {
  font-size: 22rpx;
  font-weight: 500;
}

.muted {
  color: var(--c-text-sub);
  font-size: 24rpx;
}

/* 主按钮 */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  padding: 0 48rpx;
  border-radius: 42rpx;
  background: linear-gradient(135deg, #d32f2f, #b71c1c);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(198, 40, 40, 0.28);
}
.btn-primary.is-disabled {
  background: #d8d8dc;
  color: #fff;
  box-shadow: none;
}
.btn-primary--accent {
  background: linear-gradient(135deg, #ffa733, #f5730a);
}

.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 32rpx;
  border-radius: 32rpx;
  border: 2rpx solid var(--c-line);
  color: var(--c-text);
  font-size: 26rpx;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 0 10rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  color: var(--c-primary);
  background: var(--c-primary-weak);
  margin-right: 8rpx;
}
.tag--accent {
  color: #b25a00;
  background: #fff3e0;
}

/* 底部安全区 */
.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* 占位：底部悬浮栏高度 */
.bar-holder {
  height: 140rpx;
}

/* 通用底部悬浮操作栏 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid var(--c-line);
  box-shadow: 0 -6rpx 20rpx rgba(31, 31, 31, 0.05);
}

/* 空态 */
.empty {
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty__icon {
  font-size: 96rpx;
  line-height: 1;
  opacity: 0.45;
}
.empty__text {
  margin-top: 24rpx;
  color: var(--c-text-sub);
  font-size: 26rpx;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--c-line);
  margin: 20rpx 0;
}

/* 块标题 */
.block-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0 24rpx;
  margin: 28rpx 0 12rpx;
}
.block-title::before {
  content: '';
  width: 6rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: var(--c-primary);
  margin-right: 12rpx;
}
