/* 发票抬头卡片 */
.it {
  padding: 26rpx 24rpx 0;
}
.it__head {
  display: flex;
  align-items: center;
}
.it__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--c-text);
  flex: 1;
  min-width: 0;
}
.it__type {
  flex: none;
  margin-left: 16rpx;
  font-size: 20rpx;
  color: #4a4a4f;
  background: #f4f4f6;
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
}
.it__type.is-company {
  color: var(--c-primary);
  background: var(--c-primary-weak);
}
.it__default {
  flex: none;
  margin-left: 10rpx;
  font-size: 20rpx;
  color: #fff;
  background: linear-gradient(135deg, #d32f2f, #b71c1c);
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
}
.it__row {
  display: flex;
  align-items: flex-start;
  margin-top: 12rpx;
  font-size: 25rpx;
}
.it__k {
  flex: none;
  width: 76rpx;
  color: var(--c-text-weak);
  font-size: 24rpx;
}
.it__v {
  flex: 1;
  min-width: 0;
  color: #4a4a4f;
  word-break: break-all;
  font-family: DIN, -apple-system, sans-serif;
}
.it__ops {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 22rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #f4f4f6;
}
.it__act {
  font-size: 26rpx;
  color: var(--c-text-sub);
  padding-left: 36rpx;
}
.it__act--danger {
  color: var(--c-primary);
}

/* ---------- 底部表单弹层 ---------- */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
}
.sheet__title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
}
.sheet__ops {
  display: flex;
  align-items: center;
  margin-top: 36rpx;
}
.sheet__ops .btn-ghost {
  margin-right: 20rpx;
  height: 84rpx;
  border-radius: 42rpx;
}

/* 个人 / 公司 分段控件 */
.seg {
  display: flex;
  background: #f5f5f7;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 8rpx;
}
.seg__item {
  flex: 1;
  text-align: center;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 27rpx;
  color: var(--c-text-sub);
  border-radius: 10rpx;
}
.seg__item.is-on {
  background: #fff;
  color: var(--c-primary);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(31, 31, 31, 0.08);
}

/* 表单行 */
.field {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f4f4f6;
}
.field__label {
  flex: none;
  width: 190rpx;
  font-size: 27rpx;
  color: var(--c-text);
}
.field__input {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  color: var(--c-text);
}
.field__ph {
  color: #c8c8cd;
  font-size: 25rpx;
}
