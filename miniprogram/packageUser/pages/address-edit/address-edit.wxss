.page {
  min-height: 100vh;
}

/* ---------- 表单 ---------- */
.form {
  padding: 8rpx 24rpx;
}
.form__row {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  border-bottom: 1rpx solid #f4f4f6;
}
.form__row--area {
  align-items: flex-start;
  padding: 22rpx 0;
}
.form__row--last {
  border-bottom: none;
}
.form__label {
  flex: none;
  width: 150rpx;
  font-size: 28rpx;
  color: var(--c-text);
}
.form__input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--c-text);
  height: 100rpx;
}
.form__picker {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--c-text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.form__picker.is-ph {
  color: var(--c-text-weak);
}
.form__arrow {
  flex: none;
  color: #c8c8cd;
  font-size: 32rpx;
  margin-left: 8rpx;
}
.form__textarea {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--c-text);
  line-height: 1.55;
  min-height: 96rpx;
  width: auto;
}
.form__ph {
  color: var(--c-text-weak);
  font-size: 28rpx;
}

/* ---------- 标签 ---------- */
.tags {
  display: flex;
  flex-wrap: wrap;
}
.tags__item {
  min-width: 96rpx;
  text-align: center;
  padding: 10rpx 22rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: #f4f4f6;
  color: var(--c-text-sub);
  font-size: 24rpx;
}
.tags__item.is-on {
  background: var(--c-primary-weak);
  color: var(--c-primary);
  font-weight: 500;
}

/* ---------- 默认地址开关 ---------- */
.switch-row {
  display: flex;
  align-items: center;
  padding: 26rpx 24rpx;
}
.switch-row__main {
  flex: 1;
  min-width: 0;
}
.switch-row__title {
  font-size: 28rpx;
  color: var(--c-text);
}
.switch-row__sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--c-text-weak);
}

.action-bar .btn-ghost {
  margin-right: 20rpx;
  flex: none;
}
.action-bar .grow {
  flex: 1;
}
