<!-- 个人资料：头像 / 昵称 / 性别 / 手机号 / 生日 / 城市 -->
<view class="page" style="{{themeStyle}}">
  <view class="card form">
    <!-- 头像：chooseAvatar 必须挂在 button 上，外层 wrap 约束尺寸（原生组件自带样式不受 CSS 约束） -->
    <view class="form__row">
      <text class="form__label">头像</text>
      <view class="avatar-wrap">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" hover-class="none" aria-label="更换头像">
          <image wx:if="{{user.avatar && !avatarBroken}}" class="avatar-img" src="{{user.avatar}}" mode="aspectFill" binderror="onAvatarError" />
          <view wx:else class="avatar-ph">{{avatarText}}</view>
        </button>
      </view>
      <text class="form__hint">点击更换</text>
    </view>

    <view class="form__row">
      <text class="form__label">昵称</text>
      <input
        class="form__input"
        type="nickname"
        value="{{user.nickname}}"
        placeholder="点击设置昵称"
        placeholder-class="form__ph"
        maxlength="16"
        bindblur="onNick"
        bindconfirm="onNick"
      />
    </view>

    <view class="form__row">
      <text class="form__label">性别</text>
      <view class="genders">
        <view
          wx:for="{{genders}}"
          wx:key="value"
          class="genders__item {{gender === item.value ? 'is-on' : ''}}"
          data-v="{{item.value}}"
          bindtap="onGender"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="form__row">
      <text class="form__label">手机号</text>
      <view class="form__value">{{user.phoneMask || '未绑定'}}</view>
      <button
        class="form__btn"
        open-type="getPhoneNumber"
        bindgetphonenumber="onBindPhone"
        hover-class="none"
      >{{user.phoneMask ? '更换' : '绑定'}}</button>
    </view>

    <picker mode="date" value="{{birthday}}" start="1900-01-01" end="{{today}}" bindchange="onBirthday">
      <view class="form__row">
        <text class="form__label">生日</text>
        <view class="form__picker {{birthday ? '' : 'is-ph'}}">{{birthday || '请选择生日'}}</view>
        <text class="form__arrow">›</text>
      </view>
    </picker>

    <picker mode="region" value="{{region}}" bindchange="onCity">
      <view class="form__row form__row--last">
        <text class="form__label">所在城市</text>
        <view class="form__picker {{city ? '' : 'is-ph'}}">{{city || '请选择城市'}}</view>
        <text class="form__arrow">›</text>
      </view>
    </picker>
  </view>

  <view class="tips">
    <text>生日与城市用于门店生日礼遇与区域活动推荐，仅你自己可见。</text>
  </view>

  <view class="bar-holder"></view>
  <view class="action-bar">
    <view class="btn-primary grow {{hasPending ? '' : 'is-disabled'}}" bindtap="onSave">{{saving ? '保存中…' : (hasPending ? '保存资料' : '资料已同步')}}</view>
  </view>
</view>
