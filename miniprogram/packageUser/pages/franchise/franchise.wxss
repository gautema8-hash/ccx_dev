/* ---------- 全屏海报 ---------- */
.page--poster {
  padding-bottom: 24rpx;
}
.poster {
  padding: 40rpx 40rpx 36rpx;
  background: linear-gradient(160deg, #d32f2f 0%, #b71c1c 55%, #8e1414 100%);
  border-radius: 0 0 40rpx 40rpx;
}
.poster__brand {
  display: flex;
  align-items: center;
}
.poster__logo {
  font-size: 40rpx;
  margin-right: 12rpx;
}
.poster__name {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffe3b0;
  letter-spacing: 2rpx;
}
.poster__badge {
  margin-left: auto;
  font-size: 20rpx;
  color: #b71c1c;
  background: #ffe3b0;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  font-weight: 600;
}
.poster__title {
  margin-top: 44rpx;
  font-size: 46rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.35;
  letter-spacing: 1rpx;
}
.poster__sub {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.82);
  line-height: 1.6;
}
.poster__note {
  margin-top: 28rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.66);
}

/* ---------- 亮点四宫格 ---------- */
.hl {
  display: flex;
  flex-wrap: wrap;
  margin-top: 36rpx;
}
.hl__item {
  width: calc(50% - 10rpx);
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx;
  background: rgba(255, 255, 255, 0.13);
  border-radius: 18rpx;
  display: flex;
  flex-direction: column;
}
.hl__item:nth-child(odd) {
  margin-right: 20rpx;
}
.hl__icon {
  font-size: 30rpx;
}
.hl__value {
  margin-top: 10rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
}
.hl__label {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* ---------- 二维码卡片 ---------- */
.qr {
  margin-top: 8rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.16);
}
.qr__box {
  width: 380rpx;
  height: 380rpx;
  border-radius: 20rpx;
  background: #fafafc;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.qr__img {
  width: 100%;
  height: 100%;
}

/* 未配置二维码时的纯 CSS 占位图 */
.qr__ph {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.qr__corner {
  position: absolute;
  width: 76rpx;
  height: 76rpx;
  border: 10rpx solid #c62828;
  border-radius: 8rpx;
  box-sizing: border-box;
}
.qr__corner--tl {
  left: 28rpx;
  top: 28rpx;
}
.qr__corner--tr {
  right: 28rpx;
  top: 28rpx;
}
.qr__corner--bl {
  left: 28rpx;
  bottom: 28rpx;
}
.qr__ph-txt {
  font-size: 34rpx;
  font-weight: 700;
  color: #c62828;
  letter-spacing: 4rpx;
}
.qr__ph-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #b8b8bd;
}

.qr__tip {
  margin-top: 24rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1f1f1f;
  text-align: center;
}
.qr__id {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #8a8a8e;
}
.qr__copy {
  color: #c62828;
  font-weight: 600;
  margin-left: 6rpx;
}

/* ---------- 操作区 ---------- */
.ops {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx 0;
}
.ops .btn-ghost {
  margin-left: 20rpx;
  height: 84rpx;
  border-radius: 42rpx;
  background: #fff;
}
.ops--sub {
  padding-top: 20rpx;
}
.ops--sub .btn-ghost {
  margin-left: 0;
}

/* 离屏画布：必须在渲染树里才能取到 node，但不能影响页面布局 */
.offcanvas {
  position: fixed;
  left: -2000rpx;
  top: 0;
  width: 750px;
  height: 1180px;
}
