.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--c-bg, #f5f5f7);
}

/* ---------- 一级 tab ---------- */
.tabs {
  flex: none;
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid var(--c-line, #ededf0);
}
.tabs__item {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 29rpx;
  color: var(--c-sub, #8a8a8e);
  position: relative;
}
.tabs__item.is-on {
  color: var(--c-primary, #c62828);
  font-weight: 600;
}
.tabs__item.is-on::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--c-primary, #c62828);
}

.selectbar {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 28rpx;
  background: var(--c-primary-weak, #fdecec);
  font-size: 24rpx;
  color: var(--c-primary, #c62828);
}
.selectbar__none {
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  background: #fff;
}

/* ---------- 门店条 ---------- */
.storebar {
  flex: none;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 20rpx 24rpx 0;
  padding: 18rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  font-size: 26rpx;
}
.storebar__icon {
  font-size: 28rpx;
}
.storebar__name {
  flex: 1;
  min-width: 0;
  font-weight: 600;
}
.storebar__tip {
  flex: none;
  font-size: 22rpx;
  color: var(--c-sub, #8a8a8e);
}
.storebar__arrow {
  color: #c8c8cd;
}

/* ---------- 二级 tab ---------- */
.subtabs {
  flex: none;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx 0;
}
.subtabs__item {
  padding: 8rpx 24rpx;
  border-radius: 28rpx;
  background: #fff;
  font-size: 25rpx;
  color: var(--c-sub, #8a8a8e);
}
.subtabs__item.is-on {
  background: var(--c-primary, #c62828);
  color: #fff;
  font-weight: 600;
}

/* ---------- 列表 ---------- */
.list {
  flex: 1;
  min-height: 0;
  padding: 16rpx 24rpx 0;
}
.holder {
  height: 60rpx;
}

.coupon {
  position: relative;
  display: flex;
  align-items: stretch;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 18rpx rgba(198, 40, 40, 0.07);
  padding-right: 150rpx;
}
.coupon.is-disabled {
  opacity: 0.55;
}
.coupon.is-selectable {
  border: 2rpx solid var(--c-primary, #c62828);
}
.coupon__left {
  width: 196rpx;
  flex: none;
  padding: 30rpx 0;
  text-align: center;
  background: linear-gradient(160deg, var(--c-primary, #c62828), var(--c-primary-dark, #9e1b1b));
  color: #fff;
}
.coupon.is-disabled .coupon__left {
  background: linear-gradient(160deg, #b8b8bd, #9a9aa0);
}
.coupon__value {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.05;
}
.coupon__threshold {
  font-size: 20rpx;
  opacity: 0.86;
  margin-top: 10rpx;
}
.coupon__dash {
  width: 2rpx;
  flex: none;
  margin: 20rpx 0;
  background-image: linear-gradient(#e8e8ec 60%, transparent 0);
  background-size: 2rpx 14rpx;
  background-repeat: repeat-y;
}
.coupon__right {
  flex: 1;
  min-width: 0;
  padding: 22rpx 20rpx;
}
.coupon__name {
  font-size: 28rpx;
  font-weight: 600;
}
.coupon__scope {
  font-size: 22rpx;
  color: var(--c-sub, #8a8a8e);
  margin-top: 8rpx;
}
.coupon__expire {
  font-size: 21rpx;
  color: #b8b8bd;
  margin-top: 8rpx;
}
.coupon__left-count {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #b8b8bd;
}
.coupon__reason {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #b25a00;
}
.coupon__save {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: var(--c-primary, #c62828);
  font-weight: 600;
}
.coupon__btn {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #d32f2f, #b71c1c);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  line-height: 1.25;
}
.coupon__btn.is-disabled {
  background: #dcdce2;
}
.coupon__pick {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  height: 62rpx;
  padding: 0 30rpx;
  border-radius: 31rpx;
  background: linear-gradient(135deg, #d32f2f, #b71c1c);
  color: #fff;
  font-size: 25rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}
.coupon__stamp {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%) rotate(-14deg);
  font-size: 26rpx;
  font-weight: 600;
  color: #c8c8cd;
  border: 3rpx solid #e2e2e6;
  border-radius: 10rpx;
  padding: 6rpx 14rpx;
}

.empty__btn {
  margin-top: 28rpx;
  height: 72rpx;
  padding: 0 52rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #d32f2f, #b71c1c);
  color: #fff;
  font-size: 27rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}
