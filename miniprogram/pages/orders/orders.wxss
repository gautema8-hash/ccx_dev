.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ---------- 状态筛选 ---------- */
.tabs {
  display: flex;
  background: #fff;
  padding: 0 12rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1rpx solid #ededf0;
}
.tabs__item {
  position: relative;
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #8a8a8e;
  transition: color 0.18s ease;
}
.tabs__item.is-on {
  color: #c62828;
  font-weight: 600;
}
.tabs__item.is-on::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #c62828;
}
.tabs__badge {
  position: absolute;
  right: 24rpx;
  top: 18rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border-radius: 14rpx;
  background: #c62828;
  color: #fff;
  font-size: 18rpx;
  line-height: 28rpx;
  text-align: center;
}

/* ---------- 订单卡 ---------- */
.order {
  background: #fff;
  border-radius: 20rpx;
  margin: 20rpx 24rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 31, 31, 0.04);
}
.order__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.order__shop {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
}
.order__status {
  font-size: 26rpx;
  font-weight: 600;
  margin-left: 16rpx;
  flex: none;
}
.order__body {
  display: flex;
  margin-top: 22rpx;
}
.order__thumbs {
  display: flex;
  flex: none;
}
.order__thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #fff6ec, #ffe9d2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 10rpx;
}
.order__info {
  flex: 1;
  min-width: 0;
  margin-left: 8rpx;
}
.order__names {
  font-size: 24rpx;
  color: #5c5c60;
  line-height: 1.5;
}
.order__meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #b8b8bd;
}
.order__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f4f4f6;
}
.order__time {
  font-size: 22rpx;
  color: #b8b8bd;
}
.order__pay {
  font-size: 24rpx;
  color: #5c5c60;
}
.order__amount {
  color: #c62828;
  font-size: 32rpx;
  font-weight: 600;
  font-family: DIN, -apple-system, sans-serif;
}
.order__actions {
  display: flex;
  justify-content: flex-end;
  gap: 18rpx;
  margin-top: 22rpx;
}
.order__btn {
  height: 64rpx;
  padding: 0 32rpx;
  font-size: 26rpx;
}
.order__btn--primary {
  height: 64rpx;
  font-size: 26rpx;
  box-shadow: none;
}

.list-end {
  text-align: center;
  color: #c8c8cd;
  font-size: 22rpx;
  padding: 24rpx 0;
}
.loading {
  text-align: center;
  color: #b8b8bd;
  font-size: 26rpx;
  padding: 160rpx 0;
}
.empty__btn {
  margin-top: 32rpx;
  height: 76rpx;
  padding: 0 56rpx;
  border-radius: 38rpx;
  background: linear-gradient(135deg, #d32f2f, #b71c1c);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}
