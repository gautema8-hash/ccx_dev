<!-- 我的：用户卡 + 权益数据 + 分组功能入口（交易资产 / 门店服务 / 账户设置） -->
<view class="page" style="{{themeStyle}}">
  <!-- ============ 用户卡 ============ -->
  <!-- 头像与名字的四种状态由 syncProfile() 统一派生：
       未登录 / 已登录未设置 / 已设置 / 头像加载失败 -->
  <view class="ucard">
    <!-- 头像：open-type=chooseAvatar 必须挂在 button 上，但微信 button 自带
         padding/宽度默认值，直接用会渲染成一个大椭圆。所以：
         ① 外层 wrap 固定 132rpx 圆形，裁剪交给 button 自身；
         ② 相机角标挂在 wrap 上，wrap 不裁剪，角标才能完整露出 -->
    <view class="ucard__avatar-wrap">
      <button
        class="ucard__avatar"
        open-type="chooseAvatar"
        bindchooseavatar="onChooseAvatar"
        hover-class="none"
        aria-label="更换头像"
      >
        <image
          wx:if="{{user.avatar && !avatarBroken}}"
          class="ucard__img"
          src="{{user.avatar}}"
          mode="aspectFill"
          binderror="onAvatarError"
        />
        <view wx:else class="ucard__ph">{{avatarText}}</view>
      </button>
      <view class="ucard__camera">📷</view>
    </view>

    <!-- 昵称区：展示态与编辑态分离渲染。不能直接摆 input(type=nickname)：
         原生组件自带系统背景、尺寸不受 CSS 约束，iOS 上会撑出一块大底把名字顶到角落。
         点名字就地改昵称（不跳页）；完整资料（性别/生日/城市）走「个人资料」入口，两者职责分开。
         注意：这里只允许一条注释 —— 相邻两条多行注释会让后续 wx:if 节点被编译器静默丢弃。 -->
    <view class="ucard__main">
      <view wx:if="{{isLogin && !editingNick}}" class="ucard__nick" bindtap="onNickTap">
        <text class="ucard__nick-text">{{displayName}}</text>
        <text class="ucard__nick-edit">✎</text>
      </view>
      <!-- 编辑态：由微信昵称填写能力接管（原生输入框，此时出现系统样式属正常） -->
      <input
        wx:if="{{isLogin && editingNick}}"
        class="ucard__nick-input"
        type="nickname"
        value="{{user.nickname}}"
        placeholder="点击设置昵称"
        placeholder-class="ucard__ph-text"
        maxlength="16"
        focus
        bindblur="onNickDone"
        bindconfirm="onNickDone"
      />
      <view wx:if="{{!isLogin}}" class="ucard__nick ucard__nick--guest">{{displayName}}</view>

      <view class="ucard__sub">
        <!-- 未登录时不显示会员等级：否则会误导为「已是铜签会员」 -->
        <text wx:if="{{isLogin}}" class="ucard__level">{{user.memberName || '铜签会员'}}</text>
        <text wx:else class="ucard__level ucard__level--guest">登录后可享会员权益</text>
        <text wx:if="{{isLogin}}" class="ucard__points">成长值 {{user.points || 0}}</text>
        <text wx:if="{{isLogin && phoneBound}}" class="ucard__points">{{phoneMask}}</text>
      </view>
    </view>

    <!-- 有未保存改动时才高亮可点，避免常驻按钮误导用户去点 -->
    <view
      class="ucard__save {{hasPending ? '' : 'ucard__save--idle'}}"
      catchtap="onSaveProfile"
    >{{hasPending ? '保存' : '已同步'}}</view>
  </view>

  <!-- ============ 权益数据 ============ -->
  <view class="stats">
    <view class="stats__item" bindtap="goOrders">
      <view class="stats__num">{{stats.orderCount}}</view>
      <view class="stats__label">我的订单</view>
    </view>
    <view class="stats__line"></view>
    <view class="stats__item" bindtap="goCoupon">
      <view class="stats__num">{{stats.couponCount}}</view>
      <view class="stats__label">优惠券</view>
    </view>
    <view class="stats__line"></view>
    <view class="stats__item" bindtap="showPointsRule">
      <view class="stats__num">{{user.points || 0}}</view>
      <view class="stats__label">积分</view>
    </view>
  </view>

  <!-- ============ 分组一：交易与资产 ============ -->
  <view class="group-title">交易与资产</view>
  <view class="card menu">
    <view class="menu__item" bindtap="goOrders">
      <text class="menu__icon">🧾</text>
      <text class="menu__text">我的订单</text>
      <view class="menu__tip" wx:if="{{stats.ongoingCount}}">{{stats.ongoingCount}} 单进行中</view>
      <text class="menu__arrow">›</text>
    </view>
    <view class="menu__item" bindtap="goCoupon">
      <text class="menu__icon">🎟️</text>
      <text class="menu__text">优惠券中心</text>
      <text class="menu__tip">{{stats.couponCount || 0}} 张可用</text>
      <text class="menu__arrow">›</text>
    </view>
    <view class="menu__item" bindtap="goVoucher">
      <text class="menu__icon">🎫</text>
      <text class="menu__text">团购券核销</text>
      <text class="menu__tip">美团券到店自助核销</text>
      <text class="menu__arrow">›</text>
    </view>
    <view class="menu__item" bindtap="goInvoice">
      <text class="menu__icon">📑</text>
      <text class="menu__text">发票管理</text>
      <text class="menu__tip">{{invoiceTip}}</text>
      <text class="menu__arrow">›</text>
    </view>
    <view class="menu__item" bindtap="goAddress">
      <text class="menu__icon">🏠</text>
      <text class="menu__text">收货地址</text>
      <text class="menu__tip">{{addressTip}}</text>
      <text class="menu__arrow">›</text>
    </view>
  </view>

  <!-- ============ 分组二：门店与服务 ============ -->
  <view class="group-title">门店与服务</view>
  <view class="card menu">
    <view class="menu__item" bindtap="goStoreList">
      <text class="menu__icon">🏪</text>
      <text class="menu__text">选择门店</text>
      <text class="menu__tip ellipsis">{{store ? store.name : '未选择'}}</text>
      <text class="menu__arrow">›</text>
    </view>
    <view class="menu__item" bindtap="goService">
      <text class="menu__icon">💬</text>
      <text class="menu__text">在线客服</text>
      <text class="menu__tip">文字 / 图片 / 语音 · 有问必答</text>
      <text class="menu__arrow">›</text>
    </view>
    <view class="menu__item" bindtap="goFranchise">
      <text class="menu__icon">🤝</text>
      <text class="menu__text">加盟咨询</text>
      <text class="menu__tip">城市合伙人计划</text>
      <text class="menu__arrow">›</text>
    </view>
    <view class="menu__item" bindtap="callShop">
      <text class="menu__icon">☎️</text>
      <text class="menu__text">联系门店</text>
      <text class="menu__arrow">›</text>
    </view>
    <view class="menu__item" bindtap="openLocation">
      <text class="menu__icon">📍</text>
      <text class="menu__text">门店地址</text>
      <text class="menu__tip ellipsis">{{shop.address || ''}}</text>
      <text class="menu__arrow">›</text>
    </view>
  </view>

  <!-- ============ 分组三：账户与设置 ============ -->
  <view class="group-title">账户与设置</view>
  <view class="card menu">
    <view class="menu__item" bindtap="goProfile">
      <text class="menu__icon">👤</text>
      <text class="menu__text">个人资料</text>
      <text class="menu__tip">{{phoneMask || '完善姓名 / 生日 / 城市'}}</text>
      <text class="menu__arrow">›</text>
    </view>
    <!-- 手机号：微信一键授权（getPhoneNumber）免手动填号，绑定后同一个按钮即「更换」。
         微信登录只返回 openid，拿不到手机号，必须由用户点一次授权，详见 docs/11 第六章 -->
    <button
      class="menu__item menu__item--btn"
      open-type="getPhoneNumber"
      bindgetphonenumber="onBindPhone"
      hover-class="none"
    >
      <text class="menu__icon">📱</text>
      <text class="menu__text">{{phoneBound ? '手机号' : '绑定手机号'}}</text>
      <text class="menu__tip">{{phoneBound ? phoneMask + ' · 更换' : '微信一键授权，免填号码'}}</text>
      <text class="menu__arrow">›</text>
    </button>
    <view class="menu__item" bindtap="goSettings">
      <text class="menu__icon">⚙️</text>
      <text class="menu__text">账号设置</text>
      <text class="menu__tip">切换账号 / 退出 / 注销</text>
      <text class="menu__arrow">›</text>
    </view>
    <view class="menu__item" bindtap="goAgreement">
      <text class="menu__icon">📄</text>
      <text class="menu__text">协议及政策</text>
      <text class="menu__tip">开票须知 · 隐私 · 用户协议</text>
      <text class="menu__arrow">›</text>
    </view>
    <view class="menu__item" bindtap="showAbout">
      <text class="menu__icon">ℹ️</text>
      <text class="menu__text">关于我们</text>
      <text class="menu__tip">v{{version}}</text>
      <text class="menu__arrow">›</text>
    </view>
    <view class="menu__item" bindtap="resetLocal">
      <text class="menu__icon">🧹</text>
      <text class="menu__text">清除本地缓存</text>
      <text class="menu__arrow">›</text>
    </view>
  </view>

  <view class="footer">
    <view class="footer__line">老北京麻辣串串香 · 现串现涮</view>
    <view class="footer__sub">{{shop.openTime || ''}}</view>
  </view>
</view>
