.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ---------- 用户卡 ---------- */
.ucard {
  display: flex;
  align-items: center;
  padding: 44rpx 32rpx 52rpx;
  background: linear-gradient(160deg, #c62828 0%, #b71c1c 60%, #9e1b1b 100%);
  color: #fff;
}
.ucard__avatar {
  position: relative;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  flex: none;
  padding: 0;
  border: none;
  line-height: 1;
  /* 白色描边 + 外圈微光：让头像在红色底上不糊成一团 */
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, 0.34), 0 6rpx 18rpx rgba(0, 0, 0, 0.16);
  overflow: visible;
}
.ucard__img {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  display: block;
  /* 图片本身也裁圆，避免 aspectFill 溢出方角 */
  overflow: hidden;
}
/* 无头像 / 头像加载失败时的文字占位：品牌色渐变 + 白色首字 */
.ucard__ph {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 0;
  background: linear-gradient(145deg, #e05252 0%, #c62828 55%, #a51f1f 100%);
}
.ucard__camera {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #fff;
  color: #c62828;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #c62828;
  box-sizing: border-box;
}
.ucard__main {
  flex: 1;
  min-width: 0;
  margin-left: 26rpx;
}
.ucard__nick {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  height: 52rpx;
  line-height: 52rpx;
  /* 昵称最长 16 字，超宽必须截断而不是撑破卡片 */
  width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
/* 未登录时的展示行：不加粗，弱化存在感 */
.ucard__nick--guest {
  font-weight: 500;
  opacity: 0.85;
}
.ucard__ph-text {
  color: rgba(255, 255, 255, 0.62);
  font-size: 30rpx;
}
.ucard__sub {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
}
/* 会员标签做成胶囊，比原来的方块更精致 */
.ucard__level {
  font-size: 21rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  line-height: 1.2;
}
.ucard__level--guest {
  background: rgba(255, 255, 255, 0.14);
  border-style: dashed;
}
.ucard__points {
  font-size: 22rpx;
  opacity: 0.82;
  margin-left: 14rpx;
}
.ucard__save {
  flex: none;
  height: 60rpx;
  padding: 0 28rpx;
  border-radius: 30rpx;
  background: #fff;
  color: #c62828;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.14);
}
/* 无改动时弱化为「已同步」，不诱导点击 */
.ucard__save--idle {
  background: rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.72);
  box-shadow: none;
  font-weight: 500;
}

/* ---------- 数据条 ---------- */
.stats {
  display: flex;
  align-items: center;
  margin: -30rpx 24rpx 0;
  padding: 28rpx 0;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 31, 31, 0.06);
  position: relative;
  z-index: 2;
}
.stats__item {
  flex: 1;
  text-align: center;
}
.stats__num {
  font-size: 40rpx;
  font-weight: 600;
  color: #1f1f1f;
  font-family: DIN, -apple-system, sans-serif;
}
.stats__label {
  font-size: 22rpx;
  color: #8a8a8e;
  margin-top: 6rpx;
}
.stats__line {
  width: 1rpx;
  height: 48rpx;
  background: #ededf0;
}

/* ---------- 菜单 ---------- */
.menu {
  padding: 0 24rpx;
}
.menu__item {
  display: flex;
  align-items: center;
  height: 104rpx;
  border-bottom: 1rpx solid #f4f4f6;
}
.menu__item:last-child {
  border-bottom: none;
}
.menu__item--btn {
  width: 100%;
  padding: 0;
  background: transparent;
  text-align: left;
  line-height: 1;
  border-radius: 0;
}
.menu__icon {
  font-size: 36rpx;
  width: 56rpx;
  flex: none;
}
.menu__text {
  font-size: 28rpx;
  color: #1f1f1f;
}
.menu__tip {
  margin-left: auto;
  margin-right: 12rpx;
  font-size: 23rpx;
  color: #b8b8bd;
  max-width: 320rpx;
}
.menu__arrow {
  color: #c8c8cd;
  font-size: 32rpx;
  flex: none;
}

.footer {
  text-align: center;
  padding: 48rpx 0 24rpx;
}
.footer__line {
  font-size: 23rpx;
  color: #b8b8bd;
}
.footer__sub {
  font-size: 21rpx;
  color: #c8c8cd;
  margin-top: 8rpx;
}
