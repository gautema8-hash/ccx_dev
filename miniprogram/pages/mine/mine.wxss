.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ---------- 用户卡 ---------- */
.ucard {
  display: flex;
  align-items: center;
  padding: 44rpx 32rpx 52rpx;
  background: linear-gradient(160deg, #c62828 0%, #b71c1c 60%, #9e1b1b 100%);
  color: #fff;
}
.ucard__avatar {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  overflow: visible;
  flex: none;
  padding: 0;
  border: none;
  line-height: 1;
}
.ucard__img {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  display: block;
}
.ucard__ph {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
}
.ucard__camera {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  color: #c62828;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ucard__main {
  flex: 1;
  min-width: 0;
  margin-left: 26rpx;
}
.ucard__nick {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  height: 52rpx;
  line-height: 52rpx;
}
.ucard__ph-text {
  color: rgba(255, 255, 255, 0.6);
  font-size: 32rpx;
}
.ucard__sub {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
}
.ucard__level {
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}
.ucard__points {
  font-size: 22rpx;
  opacity: 0.8;
  margin-left: 14rpx;
}
.ucard__save {
  flex: none;
  height: 60rpx;
  padding: 0 28rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #c62828;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}

/* ---------- 数据条 ---------- */
.stats {
  display: flex;
  align-items: center;
  margin: -30rpx 24rpx 0;
  padding: 28rpx 0;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 31, 31, 0.06);
  position: relative;
  z-index: 2;
}
.stats__item {
  flex: 1;
  text-align: center;
}
.stats__num {
  font-size: 40rpx;
  font-weight: 600;
  color: #1f1f1f;
  font-family: DIN, -apple-system, sans-serif;
}
.stats__label {
  font-size: 22rpx;
  color: #8a8a8e;
  margin-top: 6rpx;
}
.stats__line {
  width: 1rpx;
  height: 48rpx;
  background: #ededf0;
}

/* ---------- 菜单 ---------- */
.menu {
  padding: 0 24rpx;
}
.menu__item {
  display: flex;
  align-items: center;
  height: 104rpx;
  border-bottom: 1rpx solid #f4f4f6;
}
.menu__item:last-child {
  border-bottom: none;
}
.menu__item--btn {
  width: 100%;
  padding: 0;
  background: transparent;
  text-align: left;
  line-height: 1;
  border-radius: 0;
}
.menu__icon {
  font-size: 36rpx;
  width: 56rpx;
  flex: none;
}
.menu__text {
  font-size: 28rpx;
  color: #1f1f1f;
}
.menu__tip {
  margin-left: auto;
  margin-right: 12rpx;
  font-size: 23rpx;
  color: #b8b8bd;
  max-width: 320rpx;
}
.menu__arrow {
  color: #c8c8cd;
  font-size: 32rpx;
  flex: none;
}

.footer {
  text-align: center;
  padding: 48rpx 0 24rpx;
}
.footer__line {
  font-size: 23rpx;
  color: #b8b8bd;
}
.footer__sub {
  font-size: 21rpx;
  color: #c8c8cd;
  margin-top: 8rpx;
}
