/* .page / .tip / .empty__hint 已在 app.wxss 全局定义 */

/* ---------- 用户卡 ---------- */
.ucard {
  display: flex;
  align-items: center;
  padding: 44rpx 32rpx 52rpx;
  background: linear-gradient(160deg, #c62828 0%, #b71c1c 60%, #9e1b1b 100%);
  color: #fff;
}
/* 外层 wrap：真正约束尺寸的元素。button 自带 padding/宽度默认值，
   靠内层 button 自己裁剪成 132rpx 圆形；wrap 不裁剪，相机角标才能完整露出 */
.ucard__avatar-wrap {
  position: relative;
  width: 132rpx;
  height: 132rpx;
  flex: none;
  border-radius: 50%;
  overflow: visible;
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, 0.34), 0 6rpx 18rpx rgba(0, 0, 0, 0.16);
}
.ucard__avatar {
  display: block;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: transparent;
  overflow: hidden;
  flex: none;
  padding: 0;
  margin: 0;
  border: none;
  line-height: 1;
  box-sizing: border-box;
}
.ucard__img {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  display: block;
  overflow: hidden;
}
/* 无头像 / 头像加载失败时的文字占位：品牌色渐变 + 白色首字 */
.ucard__ph {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 0;
  background: linear-gradient(145deg, #e05252 0%, #c62828 55%, #a51f1f 100%);
}
.ucard__camera {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #fff;
  color: #c62828;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #c62828;
  box-sizing: border-box;
  /* 角标挂在 wrap 上（wrap 已 overflow:hidden），这里把裁剪打开让角标完整露出 */
  z-index: 2;
}
/* 头像与名字紧挨：只留 18rpx 呼吸位，且整体垂直居中对齐 */
.ucard__main {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}
/* 昵称展示行：纯文本 + 编辑小铅笔，与头像紧挨 */
.ucard__nick {
  display: flex;
  align-items: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1.2;
  max-width: 100%;
}
.ucard__nick-text {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ucard__nick-edit {
  flex: none;
  margin-left: 10rpx;
  font-size: 26rpx;
  opacity: 0.65;
}
/* 编辑态的原生输入框：显式压掉 iOS 系统默认背景，避免出现大色块 */
.ucard__nick-input {
  width: 100%;
  height: 52rpx;
  min-height: 52rpx;
  line-height: 52rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  background: transparent;
  border: none;
  outline: none;
  padding: 0;
  margin: 0;
  border-radius: 0;
}
/* 未登录时的展示行：不加粗，弱化存在感 */
.ucard__nick--guest {
  font-weight: 500;
  opacity: 0.85;
}
.ucard__ph-text {
  color: rgba(255, 255, 255, 0.62);
  font-size: 30rpx;
}
.ucard__sub {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
}
/* 会员标签做成胶囊；nowrap 防止「铜签会员」在窄屏换行 */
.ucard__level {
  font-size: 21rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  line-height: 1.2;
  white-space: nowrap;
  flex: none;
}
.ucard__level--guest {
  background: rgba(255, 255, 255, 0.14);
  border-style: dashed;
}
.ucard__points {
  font-size: 22rpx;
  opacity: 0.82;
  margin-left: 14rpx;
}
.ucard__save {
  flex: none;
  height: 60rpx;
  padding: 0 28rpx;
  border-radius: 30rpx;
  background: #fff;
  color: #c62828;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.14);
}
/* 无改动时弱化为「已同步」，不诱导点击 */
.ucard__save--idle {
  background: rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.72);
  box-shadow: none;
  font-weight: 500;
}

/* ---------- 数据条 ---------- */
.stats {
  display: flex;
  align-items: center;
  margin: -30rpx 24rpx 0;
  padding: 28rpx 0;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 31, 31, 0.06);
  position: relative;
  z-index: 2;
}
.stats__item {
  flex: 1;
  text-align: center;
}
.stats__num {
  font-size: 40rpx;
  font-weight: 600;
  color: #1f1f1f;
  font-family: DIN, -apple-system, sans-serif;
}
.stats__label {
  font-size: 22rpx;
  color: #8a8a8e;
  margin-top: 6rpx;
}
.stats__line {
  width: 1rpx;
  height: 48rpx;
  background: #ededf0;
}

/* ---------- 分组标题 ---------- */
/* 三个分组（交易与资产 / 门店与服务 / 账户与设置）：用短竖线 + 小字标题分隔，
   比用更多卡片堆叠更容易扫读 */
.group-title {
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  margin: 28rpx 0 -4rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--c-text-sub);
}
.group-title::before {
  content: '';
  width: 6rpx;
  height: 22rpx;
  border-radius: 4rpx;
  background: var(--c-primary);
  margin-right: 12rpx;
}

/* ---------- 菜单 ---------- */
.menu {
  padding: 0 24rpx;
}
.menu__item {
  display: flex;
  align-items: center;
  height: 104rpx;
  border-bottom: 1rpx solid #f4f4f6;
}
.menu__item:last-child {
  border-bottom: none;
}
.menu__item--btn {
  width: 100%;
  padding: 0;
  background: transparent;
  text-align: left;
  line-height: 1;
  border-radius: 0;
}
.menu__icon {
  font-size: 36rpx;
  width: 56rpx;
  flex: none;
}
.menu__text {
  font-size: 28rpx;
  color: #1f1f1f;
}
.menu__tip {
  margin-left: auto;
  margin-right: 12rpx;
  font-size: 23rpx;
  color: #b8b8bd;
  max-width: 320rpx;
}
.menu__arrow {
  color: #c8c8cd;
  font-size: 32rpx;
  flex: none;
}

.footer {
  text-align: center;
  padding: 48rpx 0 24rpx;
}
.footer__line {
  font-size: 23rpx;
  color: #b8b8bd;
}
.footer__sub {
  font-size: 21rpx;
  color: #c8c8cd;
  margin-top: 8rpx;
}
