/* .page 基础样式来自 app.wxss；这里只补背景（门店页整页可滚动，筛选栏吸顶） */
.page {
  background: var(--c-bg, #f5f5f7);
}

/* ---------- 定位状态条 ---------- */
.locbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 20rpx 24rpx 0;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: var(--c-primary-weak, #fdecec);
  font-size: 25rpx;
  color: var(--c-primary, #c62828);
}
.locbar__icon {
  font-size: 28rpx;
}
.locbar__text {
  flex: 1;
  min-width: 0;
}
.locbar__btn {
  flex: none;
  padding: 6rpx 22rpx;
  border-radius: 24rpx;
  background: #fff;
  font-size: 24rpx;
}
.locbar.DENIED {
  background: #fff3e0;
  color: #b25a00;
}
.locbar.LOADING {
  background: #f4f4f6;
  color: #8a8a8e;
}

/* ---------- 搜索 ---------- */
.filters {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx 0;
  padding: 0 24rpx;
  height: 76rpx;
  background: #fff;
  border-radius: 38rpx;
}
.filters__icon {
  font-size: 26rpx;
  margin-right: 12rpx;
  opacity: 0.6;
}
.filters__input {
  flex: 1;
  min-width: 0;
  height: 100%;
  font-size: 27rpx;
}
.filters__ph {
  color: #b8b8bd;
  font-size: 26rpx;
}
.filters__clear {
  flex: none;
  padding-left: 16rpx;
  font-size: 24rpx;
  color: #b8b8bd;
}

/* ---------- 下拉筛选栏（吸顶，面板跟着一起吸附） ---------- */
.barwrap {
  position: sticky;
  top: 0;
  z-index: 20;
}
.bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx 12rpx;
  background: var(--c-bg, #f5f5f7);
}
.bar__item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 64rpx;
  margin-right: 14rpx;
  border-radius: 32rpx;
  background: #fff;
  font-size: 25rpx;
  color: var(--c-sub, #8a8a8e);
}
.bar__item:last-child {
  margin-right: 0;
}
.bar__item.is-active {
  color: var(--c-primary, #c62828);
  font-weight: 600;
}
.bar__item.is-on {
  background: var(--c-primary-weak, #fdecec);
  color: var(--c-primary, #c62828);
}
.bar__caret {
  font-size: 20rpx;
  opacity: 0.7;
}

/* 下拉面板：挂在吸顶栏下沿 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 19;
  background: rgba(0, 0, 0, 0.28);
}
.panel {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 100%;
  z-index: 22;
  padding: 8rpx 0;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 12rpx 32rpx rgba(31, 31, 31, 0.14);
}
.panel__item {
  padding: 24rpx 32rpx;
  font-size: 27rpx;
  color: var(--c-text, #1f1f1f);
  border-bottom: 1rpx solid #f4f4f6;
}
.panel__item:last-child {
  border-bottom: none;
}
.panel__item.is-on {
  color: var(--c-primary, #c62828);
  font-weight: 600;
  background: #fffafa;
}
.panel__note {
  padding: 16rpx 32rpx 20rpx;
  font-size: 21rpx;
  color: var(--c-text-weak, #b8b8bd);
}

/* ---------- 列表 ---------- */
.list {
  padding: 8rpx 24rpx 0;
}
.store {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
}
.store.is-current {
  border-color: var(--c-primary, #c62828);
  background: #fffafa;
}
.store__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.store__name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
}
.store__tags {
  display: flex;
  gap: 8rpx;
  flex: none;
}
.tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 21rpx;
  background: #f4f4f6;
  color: var(--c-sub, #8a8a8e);
}
.tag--accent {
  background: #fff3e0;
  color: #b25a00;
}
.tag--info {
  background: #e3f2fd;
  color: #1565c0;
}
.tag--ok {
  background: #e8f5e9;
  color: #1b8a3e;
}
.tag--current {
  background: var(--c-primary-weak, #fdecec);
  color: var(--c-primary, #c62828);
}
.store__addr {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #5c5c60;
  line-height: 1.5;
}
.store__meta {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  font-size: 23rpx;
  color: var(--c-sub, #8a8a8e);
}
.store__dist {
  color: var(--c-primary, #c62828);
  font-weight: 600;
}
.store__ops {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--c-line, #ededf0);
}
.store__op {
  height: 60rpx;
  padding: 0 26rpx;
  font-size: 25rpx;
}
.store__choose {
  margin-left: auto;
  height: 64rpx;
  padding: 0 36rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #d32f2f, #b71c1c);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}
.store.is-current .store__choose {
  background: #f4f4f6;
  color: #8a8a8e;
}
.list__holder {
  height: 40rpx;
}

.reset {
  margin-top: 32rpx;
  height: 72rpx;
  border-radius: 36rpx;
}
