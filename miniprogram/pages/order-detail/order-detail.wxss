.page {
  min-height: 100vh;
  padding-bottom: 20rpx;
}

/* ---------- 状态头 ---------- */
.banner {
  padding: 40rpx 32rpx 36rpx;
  color: #fff;
}
.banner__status {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.banner__desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.86;
}
.banner__pickup {
  margin-top: 32rpx;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.16);
}
.banner__pickup-label {
  font-size: 22rpx;
  opacity: 0.8;
}
.banner__pickup-no {
  font-size: 68rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  line-height: 1.2;
  font-family: DIN, -apple-system, sans-serif;
}
.banner__pickup-tip {
  font-size: 22rpx;
  opacity: 0.8;
}

/* ---------- 时间轴 ---------- */
.block-title--inline {
  padding: 0;
  margin: 0 0 20rpx;
}
.tl {
  padding-left: 8rpx;
}
.tl__item {
  display: flex;
  min-height: 84rpx;
}
.tl__axis {
  width: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: none;
}
.tl__dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #e2e2e6;
  margin-top: 10rpx;
  flex: none;
}
.tl__line {
  flex: 1;
  width: 2rpx;
  background: #ededf0;
  margin-top: 4rpx;
}
.tl__item.is-done .tl__dot {
  background: #c62828;
}
.tl__item.is-done .tl__line {
  background: #f3c9c9;
}
.tl__item.is-cur .tl__dot {
  box-shadow: 0 0 0 8rpx rgba(198, 40, 40, 0.14);
  animation: pulse 1.6s infinite ease-in-out;
}
@keyframes pulse {
  0%,
  100% {
    box-shadow: 0 0 0 6rpx rgba(198, 40, 40, 0.1);
  }
  50% {
    box-shadow: 0 0 0 12rpx rgba(198, 40, 40, 0.16);
  }
}
.tl__main {
  flex: 1;
  padding-bottom: 24rpx;
  margin-left: 12rpx;
}
.tl__text {
  font-size: 27rpx;
  color: #b8b8bd;
}
.tl__item.is-done .tl__text {
  color: #1f1f1f;
  font-weight: 500;
}
.tl__item.is-cur .tl__text {
  color: #c62828;
  font-weight: 600;
}
.tl__time {
  font-size: 21rpx;
  color: #c8c8cd;
  margin-top: 4rpx;
}
.tl__hint {
  font-size: 21rpx;
  color: #ff8f1f;
  padding-top: 8rpx;
}

/* ---------- 通用 ---------- */
.mt-s {
  margin-top: 18rpx;
}
.lbl {
  font-size: 28rpx;
  color: #1f1f1f;
  font-weight: 500;
}
.val {
  font-size: 26rpx;
  color: #5c5c60;
  max-width: 60%;
  text-align: right;
}
.sub {
  margin-left: 12rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #b8b8bd;
}
.copy {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #c62828;
  border: 1rpx solid #f0c8c8;
  border-radius: 6rpx;
  padding: 0 10rpx;
}
.coupon-on {
  color: #c62828;
  font-weight: 600;
}

.line {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}
.line__icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #fff6ec, #ffe9d2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex: none;
  margin-right: 16rpx;
}
.line__left {
  flex: 1;
  min-width: 0;
}
.line__name {
  font-size: 28rpx;
  color: #1f1f1f;
}
.line__spec {
  display: inline-block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #8a8a8e;
  background: #f4f4f6;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}
.line__qty {
  width: 88rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8a8a8e;
}
.line__amount {
  width: 132rpx;
  text-align: right;
  font-size: 28rpx;
  font-weight: 600;
  font-family: DIN, -apple-system, sans-serif;
}
.total {
  font-size: 38rpx;
}

.holder {
  height: 180rpx;
}
.loading {
  text-align: center;
  color: #b8b8bd;
  font-size: 26rpx;
  padding: 200rpx 0;
}

/* ---------- 更多操作 ---------- */
.ops {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.ops__btn {
  flex: 1 1 0;
  min-width: 140rpx;
  height: 76rpx;
  border-radius: 16rpx;
  background: #fafafc;
  border: 1rpx solid var(--c-line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--c-text);
}
.ops__btn--accent {
  background: #fff3e0;
  border-color: #ffe0b2;
  color: #b25a00;
}

/* ---------- 操作栏 ---------- */
.bar__ghost {
  margin-right: 16rpx;
  flex: none;
}
.bar__primary {
  flex: 1;
}
