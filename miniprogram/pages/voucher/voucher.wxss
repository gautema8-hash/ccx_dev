.page {
  height: 100vh;
  background: var(--c-bg, #f5f5f7);
}
.scroll {
  height: 100%;
}
.holder {
  height: 60rpx;
}

/* ---------- 头部 ---------- */
.hero {
  padding: 40rpx 32rpx 36rpx;
  background: linear-gradient(150deg, var(--c-primary, #c62828), var(--c-primary-dark, #9e1b1b));
  color: #fff;
}
.hero__title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.hero__sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.86;
}

/* ---------- 表单 ---------- */
.card {
  background: #fff;
  border-radius: 20rpx;
  margin: 20rpx 24rpx;
  padding: 8rpx 24rpx 24rpx;
}
.field {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  border-bottom: 1rpx solid var(--c-line, #ededf0);
}
.field__label {
  width: 160rpx;
  flex: none;
  font-size: 28rpx;
  color: #1f1f1f;
}
.field__value {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 27rpx;
  color: var(--c-primary, #c62828);
  font-weight: 500;
}
.field__arrow {
  margin-left: 8rpx;
  color: #c8c8cd;
}
.field--input {
  border-bottom: none;
}
.field__input {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  letter-spacing: 1rpx;
  height: 100rpx;
}
.field__ph {
  color: #b8b8bd;
  font-size: 26rpx;
  letter-spacing: 0;
}
.field__clear {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #f0f0f3;
  color: #9a9aa0;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.warn {
  margin-top: 12rpx;
  padding: 14rpx 20rpx;
  background: #fff3e0;
  color: #b25a00;
  border-radius: 12rpx;
  font-size: 23rpx;
}
.tips {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  background: #fafafc;
  border-radius: 14rpx;
  font-size: 22rpx;
  color: #8a8a8e;
  line-height: 1.8;
}
.submit {
  margin-top: 24rpx;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
}
.submit.is-disabled {
  opacity: 0.5;
}

/* ---------- 结果 ---------- */
.result {
  padding: 24rpx;
}
.result.is-ok {
  background: #f1f9f3;
  border: 1rpx solid #b7e0bf;
}
.result.is-fail {
  background: #fdecec;
  border: 1rpx solid #f5c2c2;
}
.result__title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.result.is-ok .result__title {
  color: #1b8a3e;
}
.result.is-fail .result__title {
  color: #c62828;
}
.result__row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  padding: 10rpx 0;
  color: #5c5c60;
}
.result__row text:last-child {
  color: #1f1f1f;
  font-weight: 500;
}
.result__tip {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #d8e8dc;
  font-size: 23rpx;
  color: #8a8a8e;
  line-height: 1.6;
}

/* ---------- 记录 ---------- */
.block-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0 32rpx;
  margin: 32rpx 0 4rpx;
}
.block-title::before {
  content: '';
  width: 6rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: var(--c-primary, #c62828);
  margin-right: 12rpx;
}
.rec {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--c-line, #ededf0);
}
.rec:last-child {
  border-bottom: none;
}
.rec__left {
  flex: 1;
  min-width: 0;
}
.rec__name {
  font-size: 28rpx;
  font-weight: 600;
}
.rec__meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a8a8e;
}
.rec__code {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #b8b8bd;
  letter-spacing: 1rpx;
}
.rec__right {
  flex: none;
  text-align: right;
  margin-left: 20rpx;
}
.rec__amount {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--c-primary, #c62828);
}
.rec__status {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #b8b8bd;
}
