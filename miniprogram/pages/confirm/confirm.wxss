.page {
  min-height: 100vh;
  padding-top: 20rpx;
}

.mt-s {
  margin-top: 18rpx;
}
.lbl {
  font-size: 28rpx;
  color: #1f1f1f;
  font-weight: 500;
}
.val {
  font-size: 28rpx;
  color: #5c5c60;
  max-width: 60%;
  text-align: right;
}
.sub {
  margin-left: 12rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #b8b8bd;
}
.arrow {
  margin-left: 8rpx;
  color: #c8c8cd;
  font-size: 30rpx;
}
.coupon-on {
  color: #c62828;
  font-weight: 600;
}

/* ---------- 明细行 ---------- */
.line {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
}
.line__left {
  flex: 1;
  min-width: 0;
}
.line__name {
  font-size: 28rpx;
  color: #1f1f1f;
}
.line__spec {
  display: inline-block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #8a8a8e;
  background: #f4f4f6;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}
.line__qty {
  width: 90rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8a8a8e;
}
.line__amount {
  width: 140rpx;
  text-align: right;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f1f1f;
  font-family: DIN, -apple-system, sans-serif;
}

.remark {
  font-size: 26rpx;
  color: #5c5c60;
  line-height: 1.6;
  word-break: break-all;
}

.amounts {
  font-size: 26rpx;
}
.amounts .total {
  font-size: 38rpx;
}

.tips {
  padding: 8rpx 32rpx 0;
  font-size: 21rpx;
  color: #b8b8bd;
  line-height: 1.6;
}

.holder {
  height: 200rpx;
}

/* ---------- 底部 ---------- */
.bar__left {
  flex: 1;
  min-width: 0;
}
.bar__label {
  font-size: 20rpx;
  color: #8a8a8e;
}
.bar__amount {
  color: #c62828;
  font-size: 42rpx;
  font-weight: 600;
  font-family: DIN, -apple-system, sans-serif;
  line-height: 1.15;
}
.bar__btn {
  flex: none;
  padding: 0 64rpx;
}
.is-press {
  transform: scale(0.96);
  opacity: 0.9;
}
