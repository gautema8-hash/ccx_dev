.page {
  min-height: 100vh;
  padding-top: 20rpx;
}

.mt {
  margin-top: 24rpx;
}
.mt-s {
  margin-top: 14rpx;
}

.lbl {
  font-size: 28rpx;
  color: #1f1f1f;
  font-weight: 500;
}

/* ---------- 就餐方式分段 ---------- */
.seg {
  display: flex;
  padding: 4rpx;
  background: #f2f2f5;
  border-radius: 30rpx;
}
.seg__item {
  height: 52rpx;
  padding: 0 26rpx;
  border-radius: 26rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  color: #8a8a8e;
  transition: all 0.18s ease;
}
.seg__item.is-on {
  background: #fff;
  color: #c62828;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}
.picker-val {
  font-size: 28rpx;
  color: #c62828;
  font-weight: 500;
}
.arrow {
  font-size: 22rpx;
  color: #b8b8bd;
}
.tip {
  padding: 14rpx 18rpx;
  background: #fafafc;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #8a8a8e;
  line-height: 1.6;
}

/* ---------- 块标题扩展 ---------- */
.block-title__req {
  margin-left: 12rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: #c62828;
  background: #fdecec;
  border-radius: 6rpx;
  padding: 0 8rpx;
  line-height: 30rpx;
}
.block-title__sub {
  margin-left: 12rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #b8b8bd;
}
.block-title__clear {
  margin-left: auto;
  padding: 0 24rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #8a8a8e;
}

/* ---------- 锅底 ---------- */
.soups {
  white-space: nowrap;
  width: 100%;
}
.soups__inner {
  display: inline-flex;
  padding: 4rpx 24rpx 8rpx;
}
.soup {
  position: relative;
  width: 200rpx;
  padding: 22rpx 16rpx 18rpx;
  margin-right: 18rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 3rpx solid transparent;
  text-align: center;
  transition: all 0.18s ease;
  flex: none;
}
.soup.is-on {
  border-color: #c62828;
  background: #fff8f8;
  box-shadow: 0 8rpx 18rpx rgba(198, 40, 40, 0.12);
}
.soup__emoji {
  font-size: 48rpx;
  line-height: 1;
}
.soup__name {
  font-size: 26rpx;
  font-weight: 600;
  margin-top: 12rpx;
}
.soup__price {
  font-size: 24rpx;
  color: #c62828;
  font-weight: 600;
  margin-top: 6rpx;
  font-family: DIN, -apple-system, sans-serif;
}
.soup__badge {
  position: absolute;
  right: -2rpx;
  top: -2rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 12rpx;
  font-size: 20rpx;
  color: #fff;
  background: linear-gradient(135deg, #ff9f43, #f5730a);
  border-radius: 0 20rpx 0 20rpx;
}
.soup.is-on::after {
  content: '✓';
  position: absolute;
  left: 12rpx;
  bottom: 10rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #c62828;
  color: #fff;
  font-size: 20rpx;
  line-height: 28rpx;
  text-align: center;
}

/* ---------- 蘸料 ---------- */
.dips {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  padding: 24rpx;
}
.dip {
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 0 22rpx;
  border-radius: 32rpx;
  background: #fafafc;
  border: 2rpx solid #ededf0;
  font-size: 25rpx;
  color: #1f1f1f;
  transition: all 0.15s ease;
}
.dip.is-on {
  border-color: #c62828;
  background: #fdecec;
  color: #c62828;
  font-weight: 600;
}
.dip__emoji {
  margin-right: 8rpx;
}
.dip__tick {
  margin-left: 8rpx;
  font-size: 22rpx;
}

/* ---------- 明细 ---------- */
.items {
  padding: 8rpx 24rpx;
}
.item {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f4f4f6;
}
.item:last-of-type {
  border-bottom: none;
}
.item__img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #fff6ec, #ffe9d2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  flex: none;
  margin-right: 18rpx;
}
.item__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.item__name {
  font-size: 29rpx;
  font-weight: 600;
}
.item__spec {
  margin-top: 8rpx;
}
.item__spec-tag {
  display: inline-block;
  font-size: 21rpx;
  color: #8a8a8e;
  background: #f4f4f6;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}
.item__bottom {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 12rpx;
}
.item__price {
  color: #c62828;
  font-weight: 600;
  font-size: 30rpx;
  font-family: DIN, -apple-system, sans-serif;
}
.item__unit {
  font-size: 20rpx;
  color: #b8b8bd;
  font-weight: 400;
}
.items__tip {
  text-align: center;
  font-size: 20rpx;
  color: #c8c8cd;
  padding: 16rpx 0 12rpx;
}

/* ---------- 备注 ---------- */
.remark {
  width: 100%;
  min-height: 80rpx;
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  background: #fafafc;
  border-radius: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
}
.remark__count {
  text-align: right;
  font-size: 20rpx;
  color: #c8c8cd;
  margin-top: 8rpx;
}

/* ---------- 金额 ---------- */
.amounts {
  font-size: 26rpx;
}
.amounts .total {
  font-size: 38rpx;
}

.holder {
  height: 180rpx;
}

/* ---------- 空态按钮 ---------- */
.empty__btn {
  margin-top: 32rpx;
  height: 76rpx;
  padding: 0 56rpx;
  border-radius: 38rpx;
  background: linear-gradient(135deg, #d32f2f, #b71c1c);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}

/* ---------- 底部结算条 ---------- */
.bar__left {
  flex: 1;
  min-width: 0;
}
.bar__label {
  font-size: 20rpx;
  color: #8a8a8e;
}
.bar__amount {
  color: #c62828;
  font-size: 40rpx;
  font-weight: 600;
  font-family: DIN, -apple-system, sans-serif;
  line-height: 1.15;
}
.bar__warn {
  font-size: 20rpx;
  color: #ff8f1f;
}
.bar__btn {
  flex: none;
  padding: 0 52rpx;
}
.is-press {
  transform: scale(0.96);
  opacity: 0.9;
}
