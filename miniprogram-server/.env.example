# ============================================================
# 老北京麻辣串串香 · 点单小程序后端 环境变量
# 复制为 .env 后按需修改。带 [生产必改] 的项上线前必须替换。
# ============================================================

# ---------- 服务 ----------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# 网关前缀，与小程序 utils/config.js 的 BASE_URL 对应
API_PREFIX=/miniapp/v1
# [生产必改] JWT 签名密钥，至少 32 位随机串
JWT_SECRET=dev-only-change-me-9f2c1a7b4e6d8f30
JWT_TTL=604800
REFRESH_TTL=2592000
# 单进程最大并发请求（超过直接 503，保护自身不被打挂）
MAX_INFLIGHT=2000
# 请求体上限
BODY_LIMIT=262144

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123!@#
DB_NAME=lbz_order
DB_CONN_LIMIT=20
DB_ACQUIRE_TIMEOUT=8000
DB_QUEUE_LIMIT=200

# ---------- Redis（可选；连不上会自动降级为「无缓存/单机限流」） ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=lbz:

# ---------- 微信小程序 ----------
# 登录模式：real = 调 code2session（需 APP_SECRET）；mock = 本地生成 openid（开发用）
LOGIN_MODE=mock
APPID=wx80a1dafad4c8a193
# [生产必填] 小程序 AppSecret（小程序后台 → 开发管理 → 开发设置）
APP_SECRET=

# ---------- 微信支付 ----------
# 支付模式：real = 真实调用微信支付 v3；mock = 本地收银台（开发/联调用）
PAY_MODE=mock
# [生产必填] 商户号
MCH_ID=
# [生产必填] 商户 API 证书序列号
MCH_SERIAL_NO=
# [生产必填] 商户 API 私钥文件路径（apiclient_key.pem）
MCH_PRIVATE_KEY_PATH=
# [生产必填] APIv3 密钥（32 位），用于回调解密
APIV3_KEY=
# 支付回调地址，必须 HTTPS 且外网可达
PAY_NOTIFY_URL=https://api.example.com/miniapp/v1/pay/notify
# 支付超时（分钟）
PAY_TIMEOUT_MIN=15

# ---------- 业务参数 ----------
# 自取打包费（分）
PACK_FEE=100
# 单笔订单最大金额（分），防刷
MAX_ORDER_AMOUNT=100000
# 单用户 15 分钟内最多下单笔数
ORDER_RATE_LIMIT=5
# 菜单缓存秒数
MENU_CACHE_TTL=60

# ---------- 内部服务接口 ----------
# 管理系统后端调用本服务 /internal/* 时必须携带；未配置则内部接口全部拒绝
INTERNAL_TOKEN=

# ---------- 商家端后台 ----------
# 连锁版管理端已升级为「员工账号 + RBAC + 门店范围」，不再使用单一 ADMIN_TOKEN。
# 该令牌仅作为旧单店模式的兼容开关保留（留空即可）。
ADMIN_TOKEN=dev-admin-token-please-change

# ---------- 团购券核销 ----------
# mock = 本地校验规则（无第三方凭据也能全链路跑通）；meituan = 真实调用美团开放平台
VOUCHER_PROVIDER=mock
# [接入美团时必填]
MEITUAN_APP_KEY=
MEITUAN_APP_SECRET=
MEITUAN_API_BASE=https://openapi.meituan.com
# 单条团购券核销的最大面值（分），超此值拒绝核销，防内部作弊
VOUCHER_MAX_FACE_VALUE=200000

# ---------- 连锁业务参数 ----------
# 附近门店最多返回多少家
NEARBY_LIMIT=20
# 附近门店搜索半径（公里）
NEARBY_RADIUS_KM=50
# 管理端访问令牌有效期（秒）；刷新令牌 7 天
STAFF_TOKEN_TTL=7200
STAFF_REFRESH_TTL=604800
